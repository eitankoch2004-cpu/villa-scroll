# קבצי JPG כפולים — הקוד מגיש רק .webp (הקבוע EXT ב-index.html).
# הקבצים נשארים על המחשב כגיבוי, אבל לא עולים ל-GitHub (~13MB חיסכון).
frames/*.jpg
frames-m/*.jpg
frames-*/*.jpg

# סרטוני מקור — כבדים, ומשמשים רק לייצור פריימים.
# הפריימים עצמם כן עולים; הסרטון לא נחוץ באתר.
*.mp4
*.mov

# קבצי מערכת של Windows ו-macOS
Thumbs.db
desktop.ini
.DS_Store
